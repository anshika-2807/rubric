# rubrik. engine — environment configuration
# Copy to engine/.env (never commit .env — it is gitignored)
#
# EVERY value in this file is server-side only. There is no build step that
# inlines env vars into browser code, and no variable here is ever sent to the
# client. Do not add a variable whose name implies client exposure.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4600

# Shows the client-state debug panel during an assessment. Leave OFF/unset in
# any environment a real candidate can reach: it reveals the cue-unlock
# mechanism, which is hidden assessment material.
# DEBUG_PANEL=on

# ─── Database ────────────────────────────────────────────────────────────────
# Unset  → zero-dependency file store at engine/.data/store.json (local dev).
# Set    → PostgreSQL. Requires `npm install` (pg). Render provides this value
#          automatically when you attach a Postgres instance.
# DATABASE_URL=postgresql://user:pass@host:5432/rubrik
#
# Render's managed Postgres requires TLS. Set this when the CA is not in the
# system trust store (the usual case on Render).
# PGSSL=require

# ─── AI providers ────────────────────────────────────────────────────────────
# Supply at least one key to run live. With no key the engine runs in MOCK MODE:
# the full pipeline still executes (state machine, geometry, thresholds are all
# real) but LLM-dependent judgments are heuristic and labelled as such.
#
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...

# Order in which providers are tried. First one holding a key wins; the rest are
# fallbacks if it errors or rate-limits.
AI_FALLBACK_ORDER=groq,gemini,openai,anthropic

# Per-task model selection. Tasks are chosen by cost, not by prestige:
#   classify  — 10 booleans per candidate turn. Smallest/cheapest model. High volume.
#   persona   — the client's spoken reply. Mid-tier; latency matters more than depth.
#   evaluate  — anchor scoring with quoted evidence. ONE call per session. Best model.
# Leave unset to use each provider's defaults (see engine/ai/router.js).
# MODEL_CLASSIFY=llama-3.1-8b-instant
# MODEL_PERSONA=llama-3.3-70b-versatile
# MODEL_EVALUATE=llama-3.3-70b-versatile

# Hard ceiling on LLM calls per assessment session. Protects free tiers from a
# runaway session. When exceeded the engine degrades to heuristics.
AI_SESSION_CALL_BUDGET=80
