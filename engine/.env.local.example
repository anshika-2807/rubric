# Groq API Configuration
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# Assessment Configuration
NEXT_PUBLIC_ASSESSMENT_MODE=development

# Web3 / Sepolia Testnet Configuration
# Ethereum Sepolia RPC endpoint (Infura, Alchemy, or public RPC)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Authorized issuer backend private key (Keep secure, never commit real key)
ISSUER_PRIVATE_KEY=your_sepolia_issuer_private_key_here

# Deployed RubricSkillCredential contract address on Sepolia
CREDENTIAL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Sepolia block explorer base URL
EXPLORER_URL=https://sepolia.etherscan.io
